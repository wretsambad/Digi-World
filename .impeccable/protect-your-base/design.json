  "narrative": {
    "northStar": "My Treehouse Workshop",
    "overview": "This document covers only the replacement Protect Your Base lesson: its native Godot desktop interface, treehouse, Pip integration, Glitch, and lesson feedback. The player's own hideout is the teaching surface. A friendly faceted neighborhood provides the setting; chunky Fredoka lettering, cream paper panels, navy outlines, and orange actions make the workshop legible and inviting.\n\nVisual authority comes from the supplied brief and the preserved opening's authored assets. This lesson is a new implementation. The preserved neighborhood opening, bedroom arrival, and typing animation remain outside this document's scope. Their existing metadata, including root .impeccable/design.json, is retained separately. This lesson's extensions live in .impeccable/protect-your-base/design.json.",
    "keyCharacteristics": [
      "A living low-poly treehouse with immediately visible personal choices.",
      "Flat cream panels with confident navy outlines and rounded controls.",
      "A friendly sculpted Pip whose fur colour belongs to the player.",
      "Physical plastic, wood, and metal upgrades that mirror learning progress.",
      "Repairable visual jokes and a gentle-motion setting."
    ],
    "rules": [
      {
        "name": "The Personal Paint Rule",
        "body": "Pip's colour changes fur. Preserve his cream markings and clothes; house paint and flag colour remain separate choices.",
        "section": "colors"
      },
      {
        "name": "The World Depth Rule",
        "body": "Let the 3D scene carry depth; keep the lesson controls flat and clearly outlined.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the brief's cream, navy, orange, chunky Fredoka, and faceted neighborhood character.",
      "Do use the real treehouse and Pip to display personal choices immediately.",
      "Do retain text labels alongside colour and material changes.",
      "Do keep keyboard focus visible and respect the saved motion setting.",
      "Do reuse the authored Pip sculpt and neighborhood models with their local source provenance."
    ],
    "donts": [
      "Don't treat Pip's colour as a clothing or accessory choice; it recolours fur.",
      "Don't substitute web or iOS component conventions for the native Godot implementation.",
      "Don't present the teaching meter as a real password-strength evaluator.",
      "Don't apply this lesson's layout or metadata to the preserved opening and bedroom."
    ]
  }
}
